{
  "name": "quizbude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quizbude — Multiplayer-Quiz fuer Spieleabende. Durchstich.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/protocol",
    "packages/core",
    "packages/server",
    "apps/host-web",
    "apps/player-web"
  ],
  "scripts": {
    "build": "npm run build -w @quizbude/protocol && npm run build -w @quizbude/core && npm run build -w @quizbude/server && npm run build -w @quizbude/host-web && npm run build -w @quizbude/player-web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node packages/server/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
